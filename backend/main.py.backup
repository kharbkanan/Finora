@app.post("/budgets", response_model=MonthlyBudgetResponse)
def create_monthly_budget(
    budget: MonthlyBudgetCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    if budget.month_start.day != 1:
        raise HTTPException(
            status_code=400,
            detail="month_start must be the first day of the month.",
        )

    existing_budget = (
        db.query(MonthlyBudget)
        .filter(MonthlyBudget.user_id == current_user.id)
        .filter(MonthlyBudget.category == budget.category)
        .filter(MonthlyBudget.month_start == budget.month_start)
        .first()
    )

    if existing_budget:
        raise HTTPException(
            status_code=409,
            detail="A budget already exists for this category and month.",
        )

    new_budget = MonthlyBudget(
        category=budget.category.strip(),
        budget_amount=budget.budget_amount,
        month_start=budget.month_start,
        user_id=current_user.id,
    )

    db.add(new_budget)
    db.commit()
    db.refresh(new_budget)

    return new_budget



@app.get("/budgets", response_model=list[MonthlyBudgetResponse])
def get_monthly_budgets(
    month_start: date,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    if month_start.day != 1:
        raise HTTPException(
            status_code=400,
            detail="month_start must be the first day of the month.",
        )

    budgets = (
        db.query(MonthlyBudget)
        .filter(MonthlyBudget.user_id == current_user.id)
        .filter(MonthlyBudget.month_start == month_start)
        .order_by(MonthlyBudget.category.asc())
        .all()
    )

    return budgets



@app.put("/budgets/{budget_id}", response_model=MonthlyBudgetResponse)
def update_monthly_budget(
    budget_id: int,
    budget: MonthlyBudgetCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    if budget.month_start.day != 1:
        raise HTTPException(
            status_code=400,
            detail="month_start must be the first day of the month.",
        )

    existing_budget = (
        db.query(MonthlyBudget)
        .filter(MonthlyBudget.id == budget_id)
        .filter(MonthlyBudget.user_id == current_user.id)
        .first()
    )

    if not existing_budget:
        raise HTTPException(
            status_code=404,
            detail="Budget not found.",
        )

    duplicate = (
        db.query(MonthlyBudget)
        .filter(MonthlyBudget.user_id == current_user.id)
        .filter(MonthlyBudget.category == budget.category.strip())
        .filter(MonthlyBudget.month_start == budget.month_start)
        .filter(MonthlyBudget.id != budget_id)
        .first()
    )

    if duplicate:
        raise HTTPException(
            status_code=409,
            detail="A budget already exists for this category and month.",
        )

    existing_budget.category = budget.category.strip()
    existing_budget.budget_amount = budget.budget_amount
    existing_budget.month_start = budget.month_start

    db.commit()
    db.refresh(existing_budget)

    return existing_budget


@app.delete("/budgets/{budget_id}")
def delete_monthly_budget(
    budget_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    budget = (
        db.query(MonthlyBudget)
        .filter(MonthlyBudget.id == budget_id)
        .filter(MonthlyBudget.user_id == current_user.id)
        .first()
    )

    if not budget:
        raise HTTPException(
            status_code=404,
            detail="Budget not found.",
        )

    db.delete(budget)
    db.commit()

    return {"message": "Budget deleted successfully."}



@app.get("/budgets/status")
def get_budget_status(
    month_start: date,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    if month_start.day != 1:
        raise HTTPException(
            status_code=400,
            detail="month_start must be the first day of the month.",
        )

    budgets = (
        db.query(MonthlyBudget)
        .filter(MonthlyBudget.user_id == current_user.id)
        .filter(MonthlyBudget.month_start == month_start)
        .order_by(MonthlyBudget.category.asc())
        .all()
    )

    spending_by_category = get_monthly_spending_by_category(
        db,
        current_user.id,
        month_start,
    )

    results = []

    for budget in budgets:
        budget_amount = Decimal(str(budget.budget_amount))
        spent_amount = Decimal(
            str(spending_by_category.get(budget.category, "0.00"))
        )

        remaining_amount = budget_amount - spent_amount
        usage_percent = (
            spent_amount / budget_amount * Decimal("100")
        ).quantize(Decimal("0.01"))

        if spent_amount > budget_amount:
            status = "exceeded"
        elif usage_percent >= 80:
            status = "near_limit"
        else:
            status = "on_track"

        results.append({
            "category": budget.category,
            "budget_amount": str(budget_amount.quantize(Decimal("0.01"))),
            "spent_amount": str(spent_amount.quantize(Decimal("0.01"))),
            "remaining_amount": str(remaining_amount.quantize(Decimal("0.01"))),
            "usage_percent": str(usage_percent),
            "status": status,
        })

    return {
        "month_start": month_start.isoformat(),
        "budgets": results,
    }



@app.get("/ml/expense-prediction")
def expense_prediction(
