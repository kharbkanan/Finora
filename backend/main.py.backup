@app.get("/ml/financial-health-score")
def financial_health_score(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    from collections import defaultdict

    transactions = (
        db.query(Transaction)
        .filter(Transaction.user_id == current_user.id)
        .order_by(Transaction.transaction_date.asc())
        .all()
    )

    income_by_month = defaultdict(float)
    expense_by_month = defaultdict(float)

    for transaction in transactions:
        month = transaction.transaction_date.strftime("%Y-%m")
        amount = float(transaction.amount)

        if transaction.transaction_type == "income":
            income_by_month[month] += amount
        elif transaction.transaction_type == "expense":
            expense_by_month[month] += amount

    months = sorted(set(income_by_month) | set(expense_by_month))
    recent_months = months[-3:]

    avg_income = (
        sum(income_by_month[m] for m in recent_months) / len(recent_months)
        if recent_months else 0.0
    )
    avg_expense = (
        sum(expense_by_month[m] for m in recent_months) / len(recent_months)
        if recent_months else 0.0
    )

    score = 0
    tips = []

    # 1. Spending compared with income: up to 40 points
    if avg_income > 0:
        expense_ratio = avg_expense / avg_income

        if expense_ratio <= 0.50:
            spending_points = 40
        elif expense_ratio <= 0.70:
            spending_points = 32
        elif expense_ratio <= 0.85:
            spending_points = 22
        elif expense_ratio <= 1.0:
            spending_points = 12
        else:
            spending_points = 0
            tips.append(
                "Your recorded expenses exceed your income. Review optional spending first."
            )

        score += spending_points

        if 0.50 < expense_ratio <= 1.0:
            tips.append(
                "Try to reduce avoidable expenses and keep a little more income unspent."
            )
    else:
        tips.append("Record your income to improve the accuracy of your health score.")

    # 2. Savings surplus: up to 25 points
    surplus = avg_income - avg_expense

    if avg_income > 0 and surplus > 0:
        savings_rate = surplus / avg_income

        if savings_rate >= 0.30:
            score += 25
        elif savings_rate >= 0.20:
            score += 20
        elif savings_rate >= 0.10:
            score += 15
        else:
            score += 8

        tips.append(
            "Keep building your savings consistently while ensuring essential bills are covered."
        )
    elif avg_income > 0:
        tips.append("Aim for a positive monthly surplus before increasing savings commitments.")

    # 3. Savings goals: up to 20 points
    goals = (
        db.query(SavingsGoal)
        .filter(SavingsGoal.user_id == current_user.id)
        .all()
    )

    if goals:
        total_target = sum(float(g.target_amount or 0) for g in goals)
        total_saved = sum(float(g.current_amount or 0) for g in goals)

        if total_target > 0:
            goal_progress = min(1.0, total_saved / total_target)
            score += round(goal_progress * 20)

            if goal_progress < 1:
                tips.append(
                    "Make regular contributions toward your savings goals and review your target dates."
                )
        else:
            tips.append("Set a positive target amount for your savings goals.")
    else:
        tips.append("Create a savings goal to give your saving habits a clear target.")

    # 4. Consistent tracking: up to 15 points
    if len(recent_months) >= 3:
        score += 15
    elif len(recent_months) == 2:
        score += 10
        tips.append("Track your transactions for another month for a more complete picture.")
    elif len(recent_months) == 1:
        score += 5
        tips.append("Keep recording income and expenses across multiple months.")
    else:
        tips.append("Add transactions to begin assessing your financial health.")

    score = min(100, max(0, score))

    if score >= 80:
        rating = "Excellent"
    elif score >= 65:
        rating = "Good"
    elif score >= 45:
        rating = "Fair"
    elif score >= 25:
        rating = "Needs Improvement"
    else:
        rating = "Needs Attention"

    return {
        "status": "success",
        "score": score,
        "rating": rating,
        "average_monthly_income": round(avg_income, 2),
        "average_monthly_expenses": round(avg_expense, 2),
        "estimated_monthly_surplus": round(surplus, 2),
        "months_analyzed": recent_months,
        "goals_count": len(goals),
        "tips": tips,
        "note": "This is an indicative score based on recorded transactions and goals, not a credit score or professional financial assessment.",
    }


@app.get("/ml/financial-coach")
def personalized_financial_coach(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    from collections import defaultdict

    transactions = (
        db.query(Transaction)
        .filter(Transaction.user_id == current_user.id)
        .order_by(Transaction.transaction_date.asc())
        .all()
    )

    if not transactions:
        return {
            "status": "insufficient_data",
            "message": "Add income and expense transactions to receive personalized advice.",
            "advice": [],
        }

    income_by_month = defaultdict(float)
    expenses_by_month = defaultdict(float)
    category_expenses = defaultdict(float)

    for transaction in transactions:
        month = transaction.transaction_date.strftime("%Y-%m")
        amount = float(transaction.amount)

        if transaction.transaction_type == "income":
            income_by_month[month] += amount
        elif transaction.transaction_type == "expense":
            expenses_by_month[month] += amount
            category_expenses[transaction.category or "Other"] += amount

    months = sorted(set(income_by_month) | set(expenses_by_month))
    recent_months = months[-3:]

    avg_income = (
        sum(income_by_month[m] for m in recent_months) / len(recent_months)
        if recent_months else 0.0
    )
    avg_expenses = (
        sum(expenses_by_month[m] for m in recent_months) / len(recent_months)
        if recent_months else 0.0
    )

    surplus = avg_income - avg_expenses
    advice = []

    if avg_income <= 0:
        advice.append({
            "title": "Record your income",
            "priority": "high",
            "message": "Add your income transactions to get a more useful picture of your financial health.",
        })
    elif surplus < 0:
        advice.append({
            "title": "Bring spending within income",
            "priority": "high",
            "message": f"Your recent average expenses exceed income by ₹{abs(surplus):,.0f} per month. Review optional expenses and upcoming bills.",
        })
    elif surplus == 0:
        advice.append({
            "title": "Create a monthly surplus",
            "priority": "high",
            "message": "Your recent average income and expenses are equal. Look for a manageable expense reduction to start saving.",
        })
    else:
        suggested_savings = surplus * 0.20
        advice.append({
            "title": "Build your savings consistently",
            "priority": "medium",
            "message": f"Your estimated monthly surplus is ₹{surplus:,.0f}. Consider setting aside up to ₹{suggested_savings:,.0f} monthly if your essential needs and bills are covered.",
        })

    if category_expenses:
        top_category, top_amount = max(
            category_expenses.items(), key=lambda item: item[1]
        )
        advice.append({
            "title": f"Review {top_category} spending",
            "priority": "medium",
            "message": f"{top_category} is your highest recorded expense category across all available transactions, totaling ₹{top_amount:,.0f}. Check whether any spending can be reduced.",
        })

    goals = (
        db.query(SavingsGoal)
        .filter(SavingsGoal.user_id == current_user.id)
        .all()
    )

    incomplete_goals = [
        goal for goal in goals
        if float(goal.current_amount or 0) < float(goal.target_amount or 0)
    ]

    if incomplete_goals:
        goal = min(
            incomplete_goals,
            key=lambda g: float(g.target_amount or 0) - float(g.current_amount or 0)
        )
        remaining = max(
            0.0,
            float(goal.target_amount or 0) - float(goal.current_amount or 0)
        )
        advice.append({
            "title": f"Make progress on {goal.goal_name}",
            "priority": "medium",
            "message": f"You have ₹{remaining:,.0f} remaining for this goal. Choose a realistic monthly contribution that fits your budget.",
        })

    if len(recent_months) < 2:
        advice.append({
            "title": "Improve your financial tracking",
            "priority": "low",
            "message": "Record transactions consistently over several months to make these recommendations more meaningful.",
        })

    return {
        "status": "success",
        "advice": advice,
        "months_analyzed": recent_months,
        "average_monthly_income": round(avg_income, 2),
        "average_monthly_expenses": round(avg_expenses, 2),
        "estimated_monthly_surplus": round(surplus, 2),
        "note": "Recommendations are rule-based estimates using your recorded transactions, not professional financial advice.",
    }


@app.get("/ml/goal-predictions")
def predict_savings_goals(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    from datetime import date
    from collections import defaultdict

    goals = (
        db.query(SavingsGoal)
        .filter(SavingsGoal.user_id == current_user.id)
        .all()
    )

    if not goals:
        return {
            "status": "success",
            "goals": [],
            "message": "Create a savings goal to see its achievement prediction.",
        }

    transactions = (
        db.query(Transaction)
        .filter(Transaction.user_id == current_user.id)
        .all()
    )

    monthly_income = defaultdict(float)
    monthly_expenses = defaultdict(float)

    for transaction in transactions:
        month = transaction.transaction_date.strftime("%Y-%m")
        if transaction.transaction_type == "income":
            monthly_income[month] += float(transaction.amount)
        elif transaction.transaction_type == "expense":
            monthly_expenses[month] += float(transaction.amount)

    recorded_months = sorted(
        set(monthly_income.keys()) | set(monthly_expenses.keys())
    )
    recent_months = recorded_months[-3:]

    avg_surplus = 0.0
    if recent_months:
        avg_surplus = sum(
            monthly_income[m] - monthly_expenses[m]
            for m in recent_months
        ) / len(recent_months)

    affordable_monthly = max(0.0, avg_surplus)
    today = date.today()
    predictions = []

    for goal in goals:
        target = float(goal.target_amount or 0)
        saved = float(goal.current_amount or 0)
        remaining = max(0.0, target - saved)

        required_monthly = None
        months_left = None
        estimated_months = None

        if goal.target_date:
            months_left = max(
                0,
                (goal.target_date.year - today.year) * 12
                + goal.target_date.month - today.month
            )
            if months_left > 0:
                required_monthly = round(remaining / months_left, 2)
            elif remaining > 0:
                required_monthly = round(remaining, 2)

        if remaining == 0:
            status = "achieved"
            message = "Congratulations! This goal is achieved."
        elif affordable_monthly > 0:
            estimated_months = int(
                __import__("math").ceil(remaining / affordable_monthly)
            )
            if goal.target_date and goal.target_date <= today:
                status = "overdue"
                message = "The target date has passed. Consider updating your deadline."
            elif required_monthly is not None and affordable_monthly >= required_monthly:
                status = "on_track"
                message = "Your recent estimated surplus may be enough to reach this goal on time."
            else:
                status = "needs_more_savings"
                message = "You may need to save more each month or extend the deadline."
        else:
            status = "insufficient_surplus"
            message = "Recent recorded transactions show no positive monthly surplus."

        predictions.append({
            "goal_id": goal.id,
            "goal_name": goal.goal_name,
            "target_amount": round(target, 2),
            "current_amount": round(saved, 2),
            "remaining_amount": round(remaining, 2),
            "progress_percent": round(min(100, saved / target * 100), 1) if target > 0 else 0,
            "target_date": goal.target_date.isoformat() if goal.target_date else None,
            "months_until_target": months_left,
            "required_monthly_savings": required_monthly,
            "estimated_affordable_monthly_savings": round(affordable_monthly, 2),
            "estimated_months_to_goal": estimated_months,
            "status": status,
            "message": message,
        })

    return {
        "status": "success",
        "goals": predictions,
        "average_monthly_surplus": round(avg_surplus, 2),
        "months_used": len(recent_months),
        "note": "Predictions are estimates based on recent recorded transactions, not guarantees.",
    }


@app.get("/ml/what-if-simulator")
def what_if_simulator(
    monthly_savings: float = 5000,
    months: int = 12,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    from datetime import date
    from collections import defaultdict

    if monthly_savings < 0 or months < 1 or months > 60:
        from fastapi import HTTPException
        raise HTTPException(
            status_code=400,
            detail="Monthly savings must be non-negative and months must be between 1 and 60.",
        )

    transactions = (
        db.query(Transaction)
        .filter(Transaction.user_id == current_user.id)
        .all()
    )

    monthly_income = defaultdict(float)
    monthly_expenses = defaultdict(float)

    for transaction in transactions:
        month = transaction.transaction_date.strftime("%Y-%m")

        if transaction.transaction_type == "income":
            monthly_income[month] += float(transaction.amount)
        elif transaction.transaction_type == "expense":
            monthly_expenses[month] += float(transaction.amount)

    months_found = sorted(
        set(monthly_income.keys()) | set(monthly_expenses.keys())
    )

    if not months_found:
        return {
            "status": "insufficient_data",
            "message": "Add income and expense transactions to estimate affordability.",
        }

    # Use the latest three recorded months with transactions.
    recent_months = months_found[-3:]
    avg_income = sum(monthly_income[m] for m in recent_months) / len(recent_months)
    avg_expenses = sum(monthly_expenses[m] for m in recent_months) / len(recent_months)
    estimated_surplus = avg_income - avg_expenses

    affordable_savings = max(0.0, estimated_surplus)

    planned_total = monthly_savings * months
    affordable_total = affordable_savings * months

    return {
        "status": "success",
        "months_used": len(recent_months),
        "monthly_income_average": round(avg_income, 2),
        "monthly_expenses_average": round(avg_expenses, 2),
        "estimated_monthly_surplus": round(estimated_surplus, 2),
        "estimated_affordable_monthly_savings": round(affordable_savings, 2),
        "planned_monthly_savings": round(monthly_savings, 2),
        "planned_total_savings": round(planned_total, 2),
        "estimated_affordable_total": round(affordable_total, 2),
        "difference": round(planned_total - affordable_total, 2),
        "months": months,
        "note": "Estimate based on recorded transactions from recent months. Irregular expenses and future changes are not included.",
    }


@app.get("/ml/spending-anomalies")
def spending_anomalies(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    from collections import defaultdict

    transactions = (
        db.query(Transaction)
        .filter(Transaction.user_id == current_user.id)
        .filter(Transaction.transaction_type == "expense")
        .order_by(Transaction.transaction_date.asc())
        .all()
    )

    if not transactions:
        return {
            "status": "insufficient_data",
            "message": "Add expense transactions to detect unusual spending.",
            "anomalies": [],
        }

    monthly_category = defaultdict(float)
    all_months = set()

    for transaction in transactions:
        month = transaction.transaction_date.strftime("%Y-%m")
        category = (transaction.category or "Other").strip()

        monthly_category[(month, category)] += float(transaction.amount)
        all_months.add(month)

    months = sorted(all_months)

    if len(months) < 2:
        return {
            "status": "insufficient_data",
            "message": "Record expenses across at least two different months.",
            "anomalies": [],
        }

    latest_month = months[-1]
    previous_months = months[:-1][-3:]
    categories = sorted({category for _, category in monthly_category})

    anomalies = []

    for category in categories:
        previous_values = [
            monthly_category.get((month, category), 0.0)
            for month in previous_months
        ]

        latest_amount = monthly_category.get(
            (latest_month, category), 0.0
        )

        average = (
            sum(previous_values) / len(previous_values)
            if previous_values else 0.0
        )

        # Require both a 50% increase and at least ₹1,000
        # above the historical average to flag an anomaly.
        if (
            latest_amount > average * 1.5
            and latest_amount - average >= 1000
        ):
            anomalies.append({
                "category": category,
                "latest_amount": round(latest_amount, 2),
                "historical_average": round(average, 2),
                "increase": round(latest_amount - average, 2),
                "increase_percent": (
                    round((latest_amount - average) / average * 100, 1)
                    if average > 0 else None
                ),
                "month": latest_month,
            })

    anomalies.sort(
        key=lambda item: item["increase"],
        reverse=True,
    )

    return {
        "status": "success",
        "latest_month": latest_month,
        "months_compared": previous_months,
        "anomalies": anomalies,
        "message": (
            "Unusual spending detected."
            if anomalies else
            "No unusually high category spending detected."
        ),
    }


@app.get("/ml/expense-budget-forecast")
def expense_budget_forecast(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    monthly_data = get_monthly_expenses(db, current_user.id)

    monthly_expenses = [
        item["total_expense"] for item in monthly_data
    ]

    if not monthly_data:
        return {
            "status": "insufficient_data",
            "message": "No monthly expense history is available.",
            "forecast_month": None,
            "predicted_expense": None,
            "total_budget": None,
            "budget_comparison": None,
        }

    latest_month = date.fromisoformat(
        monthly_data[-1]["month"]
    )

    if latest_month.month == 12:
        forecast_month = date(latest_month.year + 1, 1, 1)
    else:
        forecast_month = date(
            latest_month.year,
            latest_month.month + 1,
            1,
        )

    prediction = predict_next_month_from_data(monthly_expenses)

    budgets = (
        db.query(MonthlyBudget)
        .filter(MonthlyBudget.user_id == current_user.id)
        .filter(MonthlyBudget.month_start == forecast_month)
        .all()
    )

    total_budget = sum(
        (
            Decimal(str(budget.budget_amount))
            for budget in budgets
        ),
        Decimal("0.00"),
    )

    if prediction["status"] != "success":
        return {
            "status": "insufficient_data",
            "message": prediction.get(
                "message",
                "At least 3 months of expenses are required.",
            ),
            "forecast_month": forecast_month.isoformat(),
            "predicted_expense": None,
            "total_budget": str(
                total_budget.quantize(Decimal("0.01"))
            ),
            "budget_comparison": None,
        }

    predicted_expense = Decimal(
        str(prediction["predicted_expense"])
    ).quantize(Decimal("0.01"))

    difference = predicted_expense - total_budget

    if not budgets:
        comparison = "no_budget"
    elif predicted_expense > total_budget:
        comparison = "over_budget"
    elif predicted_expense == total_budget:
        comparison = "at_budget"
    else:
        comparison = "within_budget"

    return {
        "status": "success",
        "forecast_month": forecast_month.isoformat(),
        "predicted_expense": str(predicted_expense),
        "total_budget": str(
            total_budget.quantize(Decimal("0.01"))
        ),
        "difference": str(difference.quantize(Decimal("0.01"))),
        "budget_comparison": comparison,
        "months_used": prediction["months_used"],
        "model": prediction["model"],
    }
