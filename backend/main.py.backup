def mark_bill_paid(
    bill_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    db_bill = (
        db.query(Bill)
        .filter(
            Bill.id == bill_id,
            Bill.user_id == current_user.id,
