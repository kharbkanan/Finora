@app.post("/transactions", response_model=TransactionResponse)
def create_transaction(
    transaction: TransactionCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    db_transaction = Transaction(
        **transaction.model_dump(),
        user_id=current_user.id,
    )
    db.add(db_transaction)
    db.commit()
    db.refresh(db_transaction)
    return db_transaction


@app.get("/transactions", response_model=list[TransactionResponse])
def get_transactions( 
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
    ):
    return (
        db.query(Transaction)
        .filter(Transaction.user_id == current_user.id)
        .order_by(
            Transaction.transaction_date.desc(),
            Transaction.id.desc(),
        )
        .all()
    )
    


@app.delete("/transactions/{transaction_id}")
def delete_transaction(
    transaction_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    transaction = (
        db.query(Transaction)
        .filter(
            Transaction.id == transaction_id,
            Transaction.user_id == current_user.id,
        )
        .first()
    )

    if transaction is None:
        raise HTTPException(
            status_code=404,
            detail="Transaction not found",
        )

    db.delete(transaction)
    db.commit()

    return {"message": "Transaction deleted successfully"}


@app.get("/summary")
def get_financial_summary(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    income = (
        db.query(func.coalesce(func.sum(Transaction.amount), 0))
        .filter(
            Transaction.transaction_type == "income",
            Transaction.user_id == current_user.id,
        )
        .scalar()
    )

    expenses = (
        db.query(func.coalesce(func.sum(Transaction.amount), 0))
        .filter(
            Transaction.transaction_type == "expense",
            Transaction.user_id == current_user.id,
        )
        .scalar()
    )

    income = Decimal(str(income))
    expenses = Decimal(str(expenses))

    return {
        "total_income": str(income),
        "total_expenses": str(expenses),
        "balance": str(income - expenses),
    }


@app.get("/spending-by-category")
def spending_by_category(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    results = (
        db.query(
            Transaction.category,
            func.sum(Transaction.amount).label("total_spent"),
        )
        .filter(
            Transaction.transaction_type == "expense",
            Transaction.user_id == current_user.id,
        )
        .group_by(Transaction.category)
        .order_by(func.sum(Transaction.amount).desc())
        .all()
    )

    return [
        {"category": category, "total_spent": str(total_spent)}
        for category, total_spent in results
    ]



@app.get("/insights")
def get_financial_insights(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    income = (
        db.query(func.coalesce(func.sum(Transaction.amount), 0))
        .filter(
            Transaction.transaction_type == "income",
            Transaction.user_id == current_user.id,
        )
        .scalar()
    )

    expenses = (
        db.query(func.coalesce(func.sum(Transaction.amount), 0))
        .filter(
            Transaction.transaction_type == "expense",
            Transaction.user_id == current_user.id,
        )
        .scalar()
    )

    income = Decimal(str(income))
    expenses = Decimal(str(expenses))
    balance = income - expenses

    category_results = (
        db.query(
            Transaction.category,
            func.sum(Transaction.amount).label("total"),
        )
        .filter(
            Transaction.transaction_type == "expense",
            Transaction.user_id == current_user.id,
        )
        .group_by(Transaction.category)
        .order_by(func.sum(Transaction.amount).desc())
        .all()
    )

    insights = []

    if income == 0:
        insights.append(
            "Add your income records to receive more personalized insights."
        )
    else:
        savings_rate = balance / income * 100

        if balance < 0:
            insights.append(
                "Your recorded expenses exceed your income. "
                "Review spending and prioritize essential expenses."
            )
        elif savings_rate < 20:
            insights.append(
                "Your remaining balance is below 20% of recorded income. "
                "Review non-essential spending and set a savings goal."
            )
        else:
            insights.append(
                "Your remaining balance is at least 20% of recorded income. "
                "Consider setting aside money toward a savings goal."
            )

    if category_results:
        category, total = category_results[0]
        insights.append(
            f"{category} is your highest recorded spending category "
            f"at {Decimal(str(total)):.2f}."
        )
    else:
        insights.append(
            "Add expense records to discover your main spending categories."
        )

    return {
        "total_income": str(income),
        "total_expenses": str(expenses),
        "remaining_balance": str(balance),
        "insights": insights,
        "note": (
            "Insights are based only on recorded transactions, "
            "not verified bank balances or complete financial information."
        ),
    }



@app.get("/summary/monthly")
def get_monthly_summary(
    year: int = Query(ge=2000, le=2100),
    month: int = Query(ge=1, le=12),
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    start_date = date(year, month, 1)

    if month == 12:
        end_date = date(year + 1, 1, 1)
    else:
        end_date = date(year, month + 1, 1)

    results = (
        db.query(
            Transaction.transaction_type,
            func.coalesce(func.sum(Transaction.amount), 0),
        )
        .filter(
            Transaction.transaction_date >= start_date,
            Transaction.transaction_date < end_date,
            Transaction.user_id == current_user.id,
        )
        .group_by(Transaction.transaction_type)
        .all()
    )

    totals = {
        "income": Decimal("0"),
        "expense": Decimal("0"),
    }

    for transaction_type, amount in results:
        totals[transaction_type] = Decimal(str(amount))

    return {
        "year": year,
        "month": month,
        "total_income": str(totals["income"]),
        "total_expenses": str(totals["expense"]),
        "balance": str(totals["income"] - totals["expense"]),
    }


