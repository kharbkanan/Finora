@app.get("/financial-analysis/recommendations")
def financial_recommendations(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    analysis = analyze_user_spending(db, current_user.id)

    basic_recommendations = generate_financial_recommendations(
        analysis
    )

    monthly_category_data = get_user_category_monthly_spending(
        db, current_user.id
    )

    category_comparisons = compare_category_monthly_spending(
        monthly_category_data
    )

    trend_recommendations = generate_spending_trend_recommendations(
        category_comparisons
    )

    # Get budgets and expenses for the current month.
    current_month = date.today().replace(day=1)

    budgets = (
        db.query(MonthlyBudget)
        .filter(MonthlyBudget.user_id == current_user.id)
        .filter(MonthlyBudget.month_start == current_month)
        .all()
    )

    budget_data = [
        {
            "category": budget.category,
            "budget_amount": str(budget.budget_amount),
        }
        for budget in budgets
    ]

    spending_by_category = get_monthly_spending_by_category(
        db,
        current_user.id,
        current_month,
    )

    budget_recommendations = generate_budget_recommendations(
        budget_data,
        spending_by_category,
    )

    return {
        "recommendations": (
            basic_recommendations
            + trend_recommendations
            + budget_recommendations
        )
    }




