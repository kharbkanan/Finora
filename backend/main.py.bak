@app.get("/budgets/status")
def get_budget_status(
    month_start: date,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    if month_start.day != 1:
        raise HTTPException(
            status_code=400,
            detail="month_start must be the first day of the month.",
        )

    budgets = (
        db.query(MonthlyBudget)
        .filter(MonthlyBudget.user_id == current_user.id)
        .filter(MonthlyBudget.month_start == month_start)
        .order_by(MonthlyBudget.category.asc())
        .all()
    )

    spending_by_category = get_monthly_spending_by_category(
        db,
        current_user.id,
        month_start,
    )

    results = []

    for budget in budgets:
        budget_amount = Decimal(str(budget.budget_amount))
        spent_amount = Decimal(
            str(spending_by_category.get(budget.category, "0.00"))
        )

        remaining_amount = budget_amount - spent_amount
        usage_percent = (
            spent_amount / budget_amount * Decimal("100")
        ).quantize(Decimal("0.01"))

        if spent_amount > budget_amount:
            status = "exceeded"
        elif usage_percent >= 80:
            status = "near_limit"
        else:
            status = "on_track"

        results.append({
            "category": budget.category,
            "budget_amount": str(budget_amount.quantize(Decimal("0.01"))),
            "spent_amount": str(spent_amount.quantize(Decimal("0.01"))),
            "remaining_amount": str(remaining_amount.quantize(Decimal("0.01"))),
            "usage_percent": str(usage_percent),
            "status": status,
        })

    return {
        "month_start": month_start.isoformat(),
        "budgets": results,
    }



@app.get("/ml/expense-prediction")
def expense_prediction(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    monthly_data = get_monthly_expenses(db, current_user.id)

    monthly_expenses = [
        item["total_expense"]
        for item in monthly_data
    ]

    prediction = predict_next_month_expense(monthly_expenses)

    return {
        **prediction,
        "historical_months": monthly_data,
    }



@app.get("/ml/expense-budget-forecast")
def expense_budget_forecast(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    monthly_data = get_monthly_expenses(db, current_user.id)

    monthly_expenses = [
        item["total_expense"] for item in monthly_data
    ]

    if not monthly_data:
        return {
            "status": "insufficient_data",
            "message": "No monthly expense history is available.",
            "forecast_month": None,
            "predicted_expense": None,
            "total_budget": None,
            "budget_comparison": None,
        }

    latest_month = date.fromisoformat(
        monthly_data[-1]["month"]
    )

    if latest_month.month == 12:
        forecast_month = date(latest_month.year + 1, 1, 1)
    else:
        forecast_month = date(
            latest_month.year,
            latest_month.month + 1,
            1,
        )

    prediction = predict_next_month_from_data(monthly_expenses)

    budgets = (
        db.query(MonthlyBudget)
        .filter(MonthlyBudget.user_id == current_user.id)
        .filter(MonthlyBudget.month_start == forecast_month)
        .all()
    )

    total_budget = sum(
        (
            Decimal(str(budget.budget_amount))
            for budget in budgets
        ),
        Decimal("0.00"),
    )

    if prediction["status"] != "success":
        return {
            "status": "insufficient_data",
            "message": prediction.get(
                "message",
                "At least 3 months of expenses are required.",
            ),
            "forecast_month": forecast_month.isoformat(),
            "predicted_expense": None,
            "total_budget": str(
                total_budget.quantize(Decimal("0.01"))
            ),
            "budget_comparison": None,
        }

    predicted_expense = Decimal(
        str(prediction["predicted_expense"])
    ).quantize(Decimal("0.01"))

    difference = predicted_expense - total_budget

    if not budgets:
        comparison = "no_budget"
    elif predicted_expense > total_budget:
        comparison = "over_budget"
    elif predicted_expense == total_budget:
        comparison = "at_budget"
    else:
        comparison = "within_budget"

    return {
        "status": "success",
        "forecast_month": forecast_month.isoformat(),
        "predicted_expense": str(predicted_expense),
        "total_budget": str(
            total_budget.quantize(Decimal("0.01"))
        ),
        "difference": str(difference.quantize(Decimal("0.01"))),
        "budget_comparison": comparison,
        "months_used": prediction["months_used"],
        "model": prediction["model"],
    }
