                 style="width:${pct}%;background:${
                   over ? "#ef4444" : (CAT_COLORS[b.category] || "#0ea5e9")
                 }">
            </div>
          </div>
          <p class="text-xs mt-1 ${
            over ? "text-red-500" : "text-slate-400"
          }">
            ${pct}% used ${over ? "— Near / over limit" : ""}
